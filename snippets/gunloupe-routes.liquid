{% comment %}
  snippet: gunloupe-routes.liquid
  ─────────────────────────────────────────────────────────────────────────────
{% endcomment %}

{% liquid
  # Language prefix comes from Shopify, so it is right whichever language is
  # the store's primary one ('' for the primary, '/en' etc. for the others).
  assign locale_prefix = routes.root_url
  if locale_prefix == '/'
    assign locale_prefix = ''
  endif
%}

<script>
  window.GunloupeRoutes = (function() {
    var prefix = {{ locale_prefix | json }};
    var isEN   = {{ request.locale.iso_code | json }} === 'en';

    // ── Collection slugs differ per locale ──────────────────────────────────
    var firearmsCollection = isEN
      ? prefix + '/collections/firearms'
      : '/collections/armas';

    // ── Page slugs differ per locale ────────────────────────────────────────
    var myArmorerPage   = isEN ? prefix + '/pages/my-gun-safe'  : '/pages/mi-armero';
    var favoritesPage   = isEN ? prefix + '/pages/favourites'  : '/pages/favoritos';
    var comparatorPage  = isEN ? prefix + '/pages/comparator'  : '/pages/comparison-tool';
    var myAdvertsPage   = isEN ? prefix + '/pages/my-ads'      : '/pages/anuncios';
    var adDetailPage    = isEN ? prefix + '/pages/ad-detail'   : '/pages/detalle-anuncio';
    var adsConsolePage  = isEN ? prefix + '/pages/ads-console' : '/pages/consola-de-anuncios';
    var profilePage     = isEN ? prefix + '/pages/profile'     : '/pages/perfil';
    var editProfilePage = isEN ? prefix + '/pages/edit-profile': '/pages/editar-perfil';
    var classifiedPage   = isEN ? prefix + '/pages/classifieds'   : '/pages/clasificados';


    return {
      prefix           : prefix,
      isEN             : isEN,
      firearmsCollection: firearmsCollection,
      myArmorer        : myArmorerPage,
      favorites        : favoritesPage,
      comparator       : comparatorPage,
      myAdverts        : myAdvertsPage,
      adDetail         : adDetailPage,
      adsConsole       : adsConsolePage,
      profile          : profilePage,
      editProfile      : editProfilePage,
      classified        : classifiedPage,

      /** Convenience: build a full URL with optional query string */
      build: function(base, params) {
        if (!params) return base;
        var qs = typeof params === 'string' ? params : new URLSearchParams(params).toString();
        return qs ? base + '?' + qs : base;
      }
    };
  })();
</script>
